# Drishti environment variables. Copy to .env and fill in. NEVER commit real keys.

# --- SLM ---
DRISHTI_ENABLE_SLM=0
DRISHTI_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
DRISHTI_MAX_NEW_TOKENS=512

# --- accounts: plain email + password sign-in (no email verification, no SMTP) ---

# --- behaviour ---
DRISHTI_CACHE_TTL=3600
DRISHTI_HTTP_TIMEOUT=25
DRISHTI_HTTP_RETRIES=1
DRISHTI_DEFAULT_RADIUS_KM=5
DRISHTI_MAX_CANDIDATES=10
DRISHTI_FORECAST_DAYS=7
DRISHTI_USER_AGENT=Drishti/1.0 (GeoAI Hackathon; contact: you@example.com)

# --- optional official overlays (leave blank to disable) ---
WAQI_TOKEN=
IMD_API_KEY=
IMD_JWT=
